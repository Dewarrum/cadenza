{
  "name": "cadenza",
  "version": "0.1.0",
  "private": true,
  "description": "Cadenza - a browser piano rhythm game with classical pieces",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tailnet": "CADENZA_TAILNET=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "vite build && playwright test",
    "piece:add": "node tools/piece-add.ts",
    "samples:fetch": "node tools/fetch-samples.ts"
  },
  "dependencies": {
    "smplr": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "midi-file": "^1.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
